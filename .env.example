# Settings only. Token and admin ids live in .env.main
DB_URL=sqlite:////app/db/stickers.db
TZ=Europe/Moscow
DEFAULT_INTERVAL_MINUTES=240
MIN_INTERVAL_MINUTES=10
MAX_INTERVAL_MINUTES=10080
ENABLED_BY_DEFAULT=1
# EMOJI_DEFAULT_INTERVAL_MINUTES=240
# EMOJI_ENABLED_BY_DEFAULT=0
# EMOJI_MIN_POOL_PACKS=150
# DISCOVER_EMOJI_PACKS=1
ADMIN_ONLY_SETTINGS=1
PACK_PICK_ATTEMPTS=8
# how often the popular listings are re-read, in minutes (1440 = once a day)
HARVEST_INTERVAL_MINUTES=1440
# how many top packs to keep, counted across all catalogues together
POPULAR_PACKS_LIMIT=500
# upper bound on the spicy pool; well above what the sources yield today
SPICY_PACKS_LIMIT=50
# catalogue sections feeding the spicy half of the pool
SPICY_CATEGORIES=adult,entertainment
# keyword searches layered on top of those sections
SPICY_SEARCH_TERMS=мат,meme,funny,жиза,пошлые
# anime is searched, not a category
ANIME_SEARCH_TERMS=anime,neko,chibi,kawaii,waifu
# pack name endings to drop as junk, comma separated
EXCLUDED_PACK_SUFFIXES=vk,stickroom
# pack name beginnings to drop as junk, comma separated
EXCLUDED_PACK_PREFIXES=vk
# words that disqualify a pack by its Telegram title, matched anywhere in it
EXCLUDED_TITLE_WORDS=stickroom,premium_stickers,tgsticker
TLGRM_HOST=tlgrm.ru
TGLIST_HOST=tglist.info
HTTP_TIMEOUT_SECONDS=10
